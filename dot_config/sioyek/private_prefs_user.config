# Sioyek preferences — Kanagawa Dragon theme

# Table of Contents
create_table_of_contents_if_not_exists 1
max_created_toc_size 5000
flat_toc 0

# Reading
ruler_mode 1
ruler_padding 1.0
ruler_x_padding 5.0
move_screen_ratio 0.5
zoom_inc_factor 1.2
fit_to_page_width_ratio 0.75
sort_bookmarks_by_location 1
multiline_menus 1
single_click_selects_words 1

# Dark mode
dark_mode_contrast 0.8
default_dark_mode 0

# Search engines
search_url_s  https://scholar.google.com/scholar?q=
search_url_a  https://arxiv.org/search/?query=
search_url_g  https://www.google.com/search?q=
search_url_l  https://libgen.is/search.php?req=
middle_click_search_engine s

# Comic support
page_space_y 0
num_cached_pages 20

# Kanagawa Dragon colors
background_color         0.106 0.106 0.133
dark_mode_background_color 0.106 0.106 0.133
custom_background_color  0.106 0.106 0.133
custom_text_color        0.824 0.776 0.686
text_highlight_color     0.678 0.467 0.455
search_highlight_color   0.773 0.627 0.384
visual_mark_color        0.459 0.588 0.580 0.18
link_highlight_color     0.459 0.588 0.580
synctex_highlight_color  0.596 0.647 0.420
status_bar_color         0.106 0.106 0.133
status_bar_text_color    0.824 0.776 0.686
page_separator_color     0.180 0.180 0.216

# Highlights (Kanagawa palette)
highlight_color_a  0.678 0.467 0.455   # Fuji Red
highlight_color_b  0.459 0.588 0.580   # Wave Aqua
highlight_color_c  0.773 0.627 0.384   # Autumn Yellow
highlight_color_d  0.596 0.647 0.420   # Spring Green
highlight_color_e  0.647 0.475 0.631   # Sakura Pink
highlight_color_f  0.537 0.573 0.537   # Iron
highlight_color_g  0.380 0.475 0.573   # Crystal Blue
highlight_color_h  0.824 0.776 0.686   # Old White

# Startup
startup_commands toggle_custom_color
